{
  "name": "bagel-night-shift",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bagel works the night shift: an overnight personal agent that preps your tomorrow.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c yellow,cyan \"npm:server\" \"npm:web\"",
    "server": "tsx watch --clear-screen=false server/index.ts",
    "web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "npm run build && tsx server/index.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "record": "tsx scripts/record-snapshot.ts",
    "video:narrate": "tsx scripts/narrate.ts",
    "video:record": "node scripts/record-video.mjs",
    "video": "node scripts/make-video.mjs"
  },
  "dependencies": {
    "@cline/sdk": "0.0.95",
    "@fontsource/fraunces": "5.3.0",
    "@fontsource/nunito": "5.3.0",
    "@fontsource/unifrakturmaguntia": "5.3.0",
    "dotenv": "18.0.8",
    "express": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "playwright": "1.56.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "overrides": {
    "@ai-sdk/otel": "1.0.144"
  }
}
