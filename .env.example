# Copy to .env and fill in. Replay mode (the default when data/demo/snapshot.json
# exists) needs none of these; live mode needs the first three.

# Qwen 3.8 on W&B Inference (any OpenAI-compatible endpoint works)
WANDB_API_KEY=
LLM_BASE_URL=https://api.inference.wandb.ai/v1
LLM_MODEL=Qwen/Qwen3.8-27B
# LLM_API_KEY=           # key for any other OpenAI-compatible endpoint (or a local Ollama/vLLM server)

# Parallel web research (meeting briefs)
PARALLEL_API_KEY=

# ElevenLabs voices for Bagel's calls
ELEVENLABS_API_KEY=

# Optional
# BAGEL_MODE=live          # force live mode even when a recorded run exists
# DEMO_DATE=2026-10-19     # the evening Bagel starts the night shift (live mode)
# PORT=8787
